# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# operator outreach data
/.outreach/
/outreach/runs/

# Local brainstorming companion sessions
/.superpowers/

# Agent tooling state, not project content.
# `.claude/skills/` is a directory of symlinks into `.agents/skills/`, so both
# are the same vendored library and neither belongs in history.
# `.agents/product-marketing.md` is deliberately NOT ignored — it is authored
# positioning copy and the launch gate cites it as evidence.
/.claude/
/.agents/skills/

# Scratch and generated output from local verification runs
/tmp/
/output/
/.playwright-cli/

# Promo video: authored source (STORYBOARD.md, SCRIPT.md, DESIGN.md,
# compositions/, *.json) stays visible; only the ~32MB of rendered and
# captured media is ignored.
/videos/**/renders/
/videos/**/capture/
/videos/**/snapshots/
/videos/**/voice-auditions/
/videos/**/.waveform-cache/
/videos/**/.thumbnails/
*.wav
*.aiff
*.mp4
*.mov
